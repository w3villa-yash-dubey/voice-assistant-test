HOST=0.0.0.0
PORT=8080

# OpenAI-compatible API for STT + LLM (OpenAI, Groq, local server, etc.)
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
STT_MODEL=whisper-1
LLM_MODEL=gpt-4o-mini

SYSTEM_PROMPT=You are a helpful voice assistant. Keep replies short and conversational (1-3 sentences). No markdown. Prefer Hindi or Hinglish when the user speaks Hindi.

# Goonj TTS — https://huggingface.co/BH-Builds/goonj-1-82M
# Personas: hi_atul hi_meera hi_ravi hi_shivani
#           en_aman en_ananya en_arjun en_dev en_divya en_kabir en_nisha en_priya en_sameer en_tara
#           bed_hindi
GOONJ_PERSONA=hi_meera
GOONJ_LANG=auto
GOONJ_SPEED=1.0
GOONJ_DEVICE=auto
# GOONJ_CACHE_DIR=/opt/voice-assistant/models
# HF_TOKEN=

# VAD / barge-in
VAD_AGGRESSIVENESS=2
SILENCE_MS_TO_END=700
MIN_SPEECH_MS=250
BARGE_IN_MS=200
