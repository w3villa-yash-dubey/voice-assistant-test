# Small UI server
UI_HOST=0.0.0.0
UI_PORT=8080

# LiveKit local server (docker-compose / --dev defaults)
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
AGENT_NAME=mithi-voice-agent

# OpenAI-compatible API for STT + LLM (OpenAI, Groq, local server, etc.)
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
STT_MODEL=whisper-1
LLM_MODEL=gpt-4o-mini

SYSTEM_PROMPT=You are a helpful voice assistant. Keep replies short and conversational (1-3 sentences). No markdown.

# Mithi v2 Flash TTS — https://huggingface.co/Oomni/mithi-v2-flash
# Download: python scripts/download_mithi.py
MITHI_MODEL_DIR=models/mithi-v2-flash
# Languages: hi en bn gu kn ml mr or pa ta te
MITHI_LANG=en
# Voices (male): satvik anirban nakul vasant siddhant
# Voices (female): charvi ahana vaidehi malini jahnavi
MITHI_VOICE=ahana
# auto | cuda | cpu
MITHI_DEVICE=auto
# HF_TOKEN=

# Legacy Goonj (unused while agent uses Mithi)
# GOONJ_PERSONA=hi_meera
# GOONJ_LANG=auto
# GOONJ_SPEED=1.0
# GOONJ_DEVICE=auto
# GOONJ_CACHE_DIR=/opt/voice-assistant/models
